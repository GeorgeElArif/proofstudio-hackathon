# ProofStudio — production environment template (PS-017 / PS-018)
#
# Copy this file to `.env.production` (or your host's secret manager) and replace
# every placeholder value with a real production value before deploying.
#
# This file is checked in as an EXAMPLE. Every value below is a placeholder.
# Never commit real secrets. Never commit a real `.env` or `.env.production`.
#
# The PS-017 smoke verifies that this file contains placeholders only.
# The PS-018 live URL smoke (scripts/ps018_live_url_smoke.py) reads the live-URL
# variables below only when explicitly enabled against real public URLs.

# --- Required runtime settings ----------------------------------------------

PROOFSTUDIO_ENV=production
PROOFSTUDIO_API_HOST=0.0.0.0
PROOFSTUDIO_API_PORT=8000
PROOFSTUDIO_AUTH_SERVER_HOST=0.0.0.0
PROOFSTUDIO_AUTH_SERVER_PORT=8787

# Public base URL the browser/frontend will call. Replace the host with the
# real deployed API host before going live.
PROOFSTUDIO_PUBLIC_API_BASE_URL=https://replace-with-api-host

# Public base URL of the deployed Review Room frontend.
PROOFSTUDIO_PUBLIC_WEB_URL=https://replace-with-web-host

# Comma-separated allow-list of frontend origins the backend will accept via
# CORS. Must be explicit (no wildcard) in production. Mirror the web URL above.
PROOFSTUDIO_CORS_ORIGINS=https://replace-with-web-host

# PS-040C auth runtime placeholders. Runtime auth fails closed while required
# values are placeholders. Do not commit real secrets.
# PROOFSTUDIO_APP_BASE_URL is the browser-visible public web origin because
# production authentication is exposed through the same-origin web gateway.
# It must not point directly to proofstudio-auth.
PROOFSTUDIO_APP_BASE_URL=https://replace-with-web-host
PROOFSTUDIO_AUTH_SECRET=CHANGE_ME_AUTH_SECRET
PROOFSTUDIO_DATABASE_URL=postgres://replace-with-host/replace-with-database
PROOFSTUDIO_GOOGLE_CLIENT_ID=your-google-client-id
PROOFSTUDIO_GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
PROOFSTUDIO_GITHUB_CLIENT_ID=your-github-client-id
PROOFSTUDIO_GITHUB_CLIENT_SECRET=replace-with-github-client-secret
PROOFSTUDIO_APPLE_CLIENT_ID=your-apple-client-id
PROOFSTUDIO_APPLE_TEAM_ID=your-apple-team-id
PROOFSTUDIO_APPLE_KEY_ID=your-apple-key-id
PROOFSTUDIO_APPLE_PRIVATE_KEY=replace-with-apple-private-key
PROOFSTUDIO_EMAIL_PROVIDER=replace-with-email-provider
PROOFSTUDIO_EMAIL_FROM=no-reply@example.invalid
PROOFSTUDIO_EMAIL_API_KEY=replace-with-email-provider-key
PROOFSTUDIO_EMAIL_SMTP_URL=smtp://replace-with-email-host
PROOFSTUDIO_EMAIL_CAPTURE_MODE=replace-with-non-production-capture-mode
PROOFSTUDIO_DISPOSABLE_EMAIL_BLOCKLIST_SOURCE=replace-with-disposable-domain-source
PROOFSTUDIO_EMAIL_DOMAIN_ALLOWLIST=
PROOFSTUDIO_EMAIL_DOMAIN_BLOCKLIST=replace-with-domain-blocklist
PROOFSTUDIO_AUTH_RATE_LIMIT_WINDOW_SECONDS=300
PROOFSTUDIO_AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
PROOFSTUDIO_SESSION_COOKIE_NAME=proofstudio_session
PROOFSTUDIO_SESSION_COOKIE_SECURE=true

# PS-041C service-authenticated proof readback. Inject the same random token
# into FastAPI and auth-server using the deployment secret manager. Never use
# a VITE_ prefix and never expose the token to the browser or readiness output.
PROOFSTUDIO_PROOF_API_BASE_URL=https://replace-with-private-proof-api-host
PROOFSTUDIO_INTERNAL_SERVICE_TOKEN=CHANGE_ME_INTERNAL_SERVICE_TOKEN
PROOFSTUDIO_IMPORT_OPERATOR_TOKEN=CHANGE_ME_IMPORT_OPERATOR_TOKEN
PROOFSTUDIO_IMPORT_BUCKET_ALIAS=configured-import
PROOFSTUDIO_IMPORT_ROOT=import-root

# Live provider/B2 runs are NEVER the default. Keep this false unless a later
# slice intentionally flips the default for an authenticated/operator surface.
# PS-035b supersedes this truthfully with the enforced
# PROOFSTUDIO_LIVE_RUNS_ENABLED gate below; this flag stays false.
PROOFSTUDIO_RUN_LIVE_DEFAULT=false

# --- PS-035b default-off governance controls --------------------------------
#
# These are POLICY FLAGS, not secrets. They never use names containing KEY,
# TOKEN, or SECRET, and they are never printed or exposed as secrets. All four
# default OFF so live provider execution, B2 writes, paid runs, and fixture
# mutation are blocked unless an operator explicitly enables them. Dry/demo
# runs remain available with these defaults.

# Live provider execution is blocked unless this is explicitly "true".
PROOFSTUDIO_LIVE_RUNS_ENABLED=false

# B2 writes after a successful live provider run are blocked unless this is
# explicitly "true".
PROOFSTUDIO_B2_WRITES_ENABLED=false

# Local cost-cap policy gate in USD. Paid/non-free provider execution is
# blocked when the cap is zero. This is a local policy gate, not a real
# billing API integration.
PROOFSTUDIO_COST_CAP_USD=0.00

# Golden fixtures are frozen by default. Keep this true unless a later
# PM-approved slice explicitly re-pins a golden fixture.
PROOFSTUDIO_FIXTURES_FROZEN=true

# Explicit PM/human approval for any paid/live run. A live/paid run requires
# this in addition to PROOFSTUDIO_LIVE_RUNS_ENABLED. Set in the operator
# environment only when a PM has approved a specific paid run.
PROOFSTUDIO_PAID_RUN_APPROVED=false

# --- Frontend build-time variable (Vite) ------------------------------------
#
# Vite inlines VITE_* vars at build time. Set this to the public API base URL
# when building the production frontend bundle.
VITE_PROOFSTUDIO_API_BASE_URL=https://replace-with-api-host

# Production auth is first-party through the public web origin. Use that web
# origin here (or leave this build variable unset so the production browser
# resolves window.location.origin). Never point a production browser directly
# at the proofstudio-auth service origin.
VITE_PROOFSTUDIO_AUTH_BASE_URL=https://replace-with-web-host

# --- PS-018 live URL smoke (explicit, optional) ----------------------------
#
# Used ONLY by scripts/ps018_live_url_smoke.py in live URL mode. Leave these as
# placeholders here; set real non-localhost HTTPS values in your shell only when
# running the explicit live smoke against a deployed Render instance. Never set
# PS018_RUN_LIVE_URL_SMOKE=true in this template.
PS018_RUN_LIVE_URL_SMOKE=false

# --- Optional provider/storage placeholders ---------------------------------
#
# Leave these as `replace-me` for a safe dry-run-only deployment. The default
# app never calls a provider or B2 unless an operator explicitly creates a
# live proof run with `run_live=true`.

B2_BUCKET=replace-me
B2_REGION=replace-me
B2_KEY_ID=replace-me
B2_APP_KEY=replace-me
CLOUDFLARE_ACCOUNT_ID=replace-me
CLOUDFLARE_API_TOKEN=replace-me
GEMINI_API_KEY=replace-me
ELEVENLABS_API_KEY=replace-me
