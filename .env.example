# Backblaze B2 / Genblaze storage credentials
# Genblaze reads these names by default.
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=
B2_REGION=

# Optional explicit S3-compatible endpoint if needed later.
B2_ENDPOINT=

# AI provider for PS-001
GMI_API_KEY=

# Optional future AI providers
OPENAI_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
LUMAAI_API_KEY=
RUNWAYML_API_SECRET=

# App
APP_ENV=local
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# Provider Router / Free and low-cost provider experiments
PROOFSTUDIO_BUDGET_MODE=free-only

# Cloudflare Workers AI
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL_PRIMARY=@cf/bytedance/stable-diffusion-xl-lightning
CLOUDFLARE_IMAGE_MODEL_FALLBACK=@cf/stabilityai/stable-diffusion-xl-base-1.0

# No-key emergency fallback
POLLINATIONS_ENABLED=true

# Low-cost / premium-ready image providers
STABILITY_API_KEY=
RUNWARE_API_KEY=
WAVESPEED_API_KEY=

# Text fallback providers
OPENROUTER_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=

# PS-040C server auth/runtime placeholders.
# These are local examples only; do not commit real secrets or live provider
# credentials. Runtime auth fails closed while required values are placeholders.
AUTH_BASE_URL=https://example.localhost
AUTH_SECRET=CHANGE_ME_AUTH_SECRET
DATABASE_URL=postgres://replace-with-host/replace-with-database
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=replace-with-github-client-secret
APPLE_CLIENT_ID=your-apple-client-id
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY=replace-with-apple-private-key
EMAIL_PROVIDER=replace-with-email-provider
EMAIL_FROM=no-reply@example.localhost
EMAIL_PROVIDER_API_KEY=replace-with-email-provider-key
EMAIL_SMTP_URL=smtp://replace-with-email-host
EMAIL_CAPTURE_MODE=local
DISPOSABLE_EMAIL_BLOCKLIST_SOURCE=replace-with-disposable-domain-source
EMAIL_DOMAIN_ALLOWLIST=
EMAIL_DOMAIN_BLOCKLIST=blocked.test
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
SESSION_COOKIE_NAME=proofstudio_session
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SECURE=false

# PS-041C server-to-server proof read boundary. Both values are server-only.
# Inject a random value of at least 24 characters at runtime; placeholders fail closed.
PROOFSTUDIO_PROOF_API_BASE_URL=http://127.0.0.1:8000
PROOFSTUDIO_INTERNAL_SERVICE_TOKEN=CHANGE_ME_INTERNAL_SERVICE_TOKEN
PROOFSTUDIO_IMPORT_OPERATOR_TOKEN=CHANGE_ME_IMPORT_OPERATOR_TOKEN
PROOFSTUDIO_IMPORT_BUCKET_ALIAS=configured-import
PROOFSTUDIO_IMPORT_ROOT=import-root
