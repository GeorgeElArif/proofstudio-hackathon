{
  "name": "proofstudio-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ProofStudio Demo UI Shell / Review Room (PS-013). A judge-facing frontend over the PS-012 FastAPI demo contract.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
