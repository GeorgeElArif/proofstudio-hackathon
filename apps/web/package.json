    "smoke:configured-auth-client": "node scripts/smoke-configured-auth-runtime.mjs",
    "smoke:dashboard-contract": "node scripts/smoke-dashboard-contract.mjs",
    "smoke:dashboard-ui": "node scripts/smoke-dashboard-ui.mjs",
    "smoke:dashboard-account-campaigns": "node scripts/smoke-dashboard-account-campaigns.mjs",
    "smoke:private-proof-access": "node scripts/smoke-private-proof-access.mjs",
    "smoke:lineage-ui": "node scripts/smoke-lineage-ui.mjs",
